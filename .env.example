# API de CONtexto Ganadero (solo servidor). Copie este archivo a .env.local y complete la clave.
# Documentación: https://contexto-olive.vercel.app/api-docs
# La clave se crea en el panel de CONtexto (Configuración > API pública), una por integración.
CONTEXTO_API_URL=https://contexto-olive.vercel.app/api/v1
CONTEXTO_API_KEY=

# CMS del portal (Supabase). La clave de servicio es secreta: nunca se sube a git.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Dominio público (sitemap, robots, canonical). Mientras el sitio siga en vercel.app, ponga aquí esa URL.
NEXT_PUBLIC_SITE_URL=
# Google Tag Manager (GTM-XXXXXXX). Se carga solo si la persona acepta las cookies de analítica.
NEXT_PUBLIC_GTM_ID=
